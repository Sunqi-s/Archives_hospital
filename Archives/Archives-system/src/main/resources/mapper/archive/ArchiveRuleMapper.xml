<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.archives.archive.mapper.ArchiveRuleMapper">

    <resultMap type="ArchiveRule" id="ArchiveRuleResult">
        <result property="id" column="id"/>
        <result property="categoryId" column="category_id"/>
        <result property="ruleNumber" column="rule_number"/>
        <result property="ruleItem" column="rule_item"/>
        <result property="ruleJoin" column="rule_join"/>
        <result property="dealMethod" column="deal_method"/>
        <result property="dealDetail" column="deal_detail"/>
        <result property="ruleColumn" column="rule_column"/>
    </resultMap>


    <sql id="selectArchiveRuleVo">
        select id, category_id, rule_number, rule_item, rule_join, deal_method, deal_detail from archive_rule
    </sql>

    <select id="selectArchiveRuleList" parameterType="ArchiveRule" resultMap="ArchiveRuleResult">
        <include refid="selectArchiveRuleVo"/>
        <where>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="ruleNumber != null  and ruleNumber != ''"> and rule_number like concat('%', #{ruleNumber}, '%')</if>
            <if test="ruleItem != null  and ruleItem != ''"> and rule_item like concat('%', #{ruleItem}, '%')</if>
            <if test="ruleJoin != null  and ruleJoin != ''"> and rule_join like concat('%', #{ruleJoin}, '%')</if>
            <if test="dealMethod != null  and dealMethod != ''"> and deal_method = #{dealMethod}</if>
            <if test="dealDetail != null  and dealDetail != ''"> and deal_detail = #{dealDetail}</if>
        </where>
    </select>


    <select id="selectArchiveRuleById" parameterType="Long" resultMap="ArchiveRuleResult">
        <include refid="selectArchiveRuleVo"/>
        where id = #{id}
    </select>

    <insert id="insertArchiveRule" parameterType="ArchiveRule" useGeneratedKeys="true" keyProperty="id">
        insert into archive_rule (category_id, rule_number, rule_item, rule_join, deal_method, deal_detail)
        values
            <foreach collection="archiveRuleList" item="archiveRule" separator=",">
                (#{archiveRule.categoryId}, #{archiveRule.ruleNumber}, #{archiveRule.ruleItem}, #{archiveRule.ruleJoin}, #{archiveRule.dealMethod}, #{archiveRule.dealDetail})
            </foreach>
    </insert>

    <delete id="deleteArchiveRuleByCategoryId" parameterType="Long">
        delete from archive_rule where category_id = #{categoryId}
    </delete>

    <delete id="deleteArchiveRuleById" parameterType="Long">
        delete from archive_rule where id = #{id}
    </delete>

    <delete id="deleteArchiveRuleByIds" parameterType="String">
        delete from archive_rule where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="batchGetColumns" resultType="ArchiveRule">
        SELECT item_name as ruleItem, column_name as ruleColumn
        FROM archive_item
        WHERE item_name IN
        <foreach item="item" collection="itemNames" open="(" separator="," close=")">
            #{item}
        </foreach>
        AND category_id = #{categoryId}
    </select>
</mapper>
